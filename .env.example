# ===========================================
# GoyaPay AI - Plantilla de Variables de Entorno
# ===========================================
# Llena estas variables en tu entorno local o en Modal Secrets (goyapay-credentials)
# NUNCA compartas ni subas credenciales reales a GitHub.

# --- Retell AI (Voz y Telefonía) ---
RETELL_API_KEY=
RETELL_AGENT_ID=

# --- Twilio (SIP Trunk & Telefonía) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Resend (Envío de Correos Transaccionales) ---
RESEND_API_KEY=

# --- Notion (Base de Datos Académica UNAM) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Vercel (Pasarela Web3 de Checkout) ---
VERCEL_CHECKOUT_URL=https://checkout-web-seven.vercel.app/checkout

# --- Stripe (Pasarela Oficial Bancaria) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Web3 & Blockchain Multi-chain ---
# Avalanche C-Chain RPC / Contrato
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Pollar Smart Wallet (Stellar Soroban)
POLLAR_TOKEN=
